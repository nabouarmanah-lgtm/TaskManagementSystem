<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="35" prefWidth="1000"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controllers.MenuBarController">

    <MenuBar fx:id="menubar" prefWidth="1000"
             AnchorPane.topAnchor="0"
             AnchorPane.leftAnchor="0"
             AnchorPane.rightAnchor="0">
        <menus>
            <Menu text="File">
                <items>
                    <MenuItem text="Exit" onAction="#handleExit"/>
                </items>
            </Menu>
            <Menu text="Appearance">
                <items>
                    <Menu text="Font Style">
                        <items>
                            <CheckMenuItem text="Bold" onAction="#handleBold"/>
                            <CheckMenuItem text="Italic" onAction="#handleItalic"/>
                        </items>
                    </Menu>
                </items>
            </Menu>
            <Menu text="Help">
                <items>
                    <MenuItem text="About" onAction="#handleAbout"/>
                </items>
            </Menu>
        </menus>
    </MenuBar>
</AnchorPane>